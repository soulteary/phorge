# NOTE: Thinking about adding files created by your operating system, IDE,
# or text editor here? Don't! Add them to your per-user .gitignore instead.

# Diviner (retain maintained release notes)
/docs/*
!/docs/releases/
/docs/releases/*
!/docs/releases/*.md
/.divinercache/
/webroot/rsrc/externals/javelin/.divinercache/
/webroot/rsrc/externals/javelin/docs/.divinercache/
/src/.cache/

# libphutil
/src/.phutil_module_cache

# Bundled runtime: explicitly prepared parser tools and mapper caches.
/support/runtime/src/.phutil_module_cache
/support/runtime/src/parser/xhpast/bin/xhpast
/support/runtime/support/php-parser/lib/
/support/runtime/support/php-parser/php-parser-*.tar.gz
/support/runtime/support/php-parser/php-parser-*.zip
/support/runtime/support/xhpast/*.o
/support/runtime/support/xhpast/libxhpast.a
/support/runtime/support/xhpast/xhpast
/support/runtime/support/xhpast/node_names.hpp
/support/runtime/support/xhpast/parser.yacc.output

# Configuration
/conf/custom/*
/conf/local/local.json
# Docker Compose 环境变量（含数据库密码，勿提交）
/.env
/conf/local/ENVIRONMENT
/conf/local/VERSION
/conf/keys/device.pub
/conf/keys/device.key
/conf/keys/device.id
/conf/aphlict/aphlict.custom.json

# Impact Font
/resources/font/impact.ttf

# User-accessible hook for adhoc debugging scripts
/support/debug.php

# User-accessible hook for adhoc startup code
/support/preamble.php

# Users can link binaries here
/support/bin/*

# User extensions
/src/extensions/*

# NPM local packages
/support/aphlict/server/node_modules/

# Places for users to add custom resources.
/resources/cows/custom/*
/resources/figlet/custom/*

# Peast
/support/peast/peast*.tar.gz
/support/peast/peast*.zip
/support/peast/lib/*

API_KEY.txt
