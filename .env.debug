# =============================================================================
# Phorge (phorge-fork) —— Gorge 本地联调配置快照（.env.debug）
#
# 这是一份**验证过能跑通**的联调环境变量，配套「gorge 六个服务用独立 compose 栈
# （gorge/deploy/compose）跑、phorge 通过 host.docker.internal 访问它们」这套拓扑。
#
# 用法：
#   cp .env.debug .env
#   docker compose up -d --build       # 首次或改过 entrypoint.sh / PHP 源码时必须 --build
#
# 依赖的另外两处（缺一不可）：
#   1. docker-compose.override.yml —— 给 mysql 暴露 127.0.0.1:3306，给 phorge 加
#      extra_hosts(host.docker.internal) 和六个域的 GORGE_* 变量。
#   2. gorge/deploy/compose 那一侧的 .env.debug + docker-compose.override.yml，且
#      六个 gorge 服务已 up。
#
# 注意：不要叠加 docker-compose.gorge.yml —— 那会把 URI 写回 gorge-* 服务名并拉起
# 一套同名 gorge 容器，与本联调拓扑冲突。只用默认合并（compose 自动读 override）。
# =============================================================================

# --- 数据库 ---

# MySQL root 密码。只有 db-init（授权）和 mysql 自身的健康检查用到它，
# Phorge 应用不用 root 连库。
MYSQL_ROOT_PASSWORD=phorge_root

# Phorge 连库使用的普通账号。首次初始化数据卷时由 mysql 镜像创建，
# 随后由 db-init 授予 `phabricator_%` 整组库的权限。
MYSQL_USER=phorge

# 上述普通账号的密码，会同时下发给 mysql 和 phorge 两个服务。
# gorge 栈的 GORGE_FILE_MYSQL_PASS / GORGE_WEBHOOK_MYSQL_PASS 必须与它同值。
MYSQL_PASSWORD=phorge

# mysql 镜像首次初始化时顺带创建的库。Phorge 实际使用的是
# phabricator_* 命名空间下的一组库，这里只是给普通账号一个落脚的默认库，
# 保持默认值即可。
MYSQL_DATABASE=phorge

# --- Phorge 应用 ---

# 宿主机映射端口，浏览器访问 http://127.0.0.1:<该端口>/
PHORGE_HTTP_PORT=8088

# 站点自身的绝对地址，Phorge 用它生成链接并校验请求的 Host 头。
# 默认保持注释：compose 会自动拼成 http://127.0.0.1:${PHORGE_HTTP_PORT}/。
# PHORGE_BASE_URI=https://code.example.com/

# 站点默认时区（phabricator.timezone），取 PHP 时区标识符，例如 Asia/Shanghai。
PHORGE_TIMEZONE=UTC

# --- 启动行为开关（严格取值 1 开启，其它任何值都视为关闭）---
# 注意: 数据库/时区等只在首次生成 conf/local/local.json 时写入；GORGE_* 那类拓扑
# 配置由 entrypoint.sh 每次启动幂等重写，改 .env 重启即生效。

PHORGE_WAIT_DB=1
# 只有 migrate 角色读它；phd 由 daemon 角色的 phd-foreground 固定托管。
PHORGE_AUTO_UPGRADE=1

# --- Gorge 服务联调 token（本地裸跑/独立栈，均不鉴权）---
# 这些 token 被 docker-compose.override.yml 引用，phorge 侧以请求头 X-Service-Token
# 发送。留空 = 服务端不鉴权，仅本机联调可接受；一旦在 gorge 侧设了 GORGE_SERVICE_TOKEN，
# 这里对应的一项必须填成同值，否则该域全部 401。
# 注意 webhook 的 token 只保护它的两个诊断接口，投递本身不经过它。
GORGE_RENDER_TOKEN=
GORGE_MAILER_TOKEN=
GORGE_SEARCH_TOKEN=
GORGE_FILE_TOKEN=
GORGE_WEBHOOK_TOKEN=
