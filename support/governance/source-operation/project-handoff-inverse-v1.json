d user. Join policy, members, Space and hierarchy stay unchanged.' => '\u6700\u7ec8\u67e5\u770b\u548c\u7f16\u8f91\u7b56\u7565\uff1a\u6240\u9009\u7528\u6237\u3002\u52a0\u5165\u7b56\u7565\u3001\u6210\u5458\u3001Space \u548c\u5c42\u7ea7\u4fdd\u6301\u4e0d\u53d8\u3002',\n      'Your final access: view=%s, edit=%s.' => '\u4f60\u7684\u6700\u7ec8\u6743\u9650\uff1a\u67e5\u770b=%s\uff0c\u7f16\u8f91=%s\u3002',\n      'I reviewed the final policies and understand that I may lose access.' => '\u6211\u5df2\u590d\u6838\u6700\u7ec8\u7b56\u7565\uff0c\u5e76\u7406\u89e3\u81ea\u5df1\u53ef\u80fd\u5931\u53bb\u8bbf\u95ee\u6743\u9650\u3002',\n      'Confirm Handoff' => '\u786e\u8ba4\u79fb\u4ea4',\n      'Preview Final Permissions' => '\u9884\u89c8\u6700\u7ec8\u6743\u9650',\n      'Handoff Unavailable' => '\u65e0\u6cd5\u79fb\u4ea4',\n      'The handoff result could not be confirmed. Check the project history before retrying. An expired or changed preview requires a new review.' => '\u65e0\u6cd5\u786e\u8ba4\u79fb\u4ea4\u7ed3\u679c\u3002\u91cd\u8bd5\u524d\u8bf7\u68c0\u67e5\u9879\u76ee\u5386\u53f2\u3002\u9884\u89c8\u8fc7\u671f\u6216\u72b6\u6001\u53d8\u5316\u65f6\uff0c\u9700\u8981\u91cd\u65b0\u590d\u6838\u3002',\n      '%s handed the project view and edit policies to %s.' => '%s \u5c06\u9879\u76ee\u7684\u67e5\u770b\u548c\u7f16\u8f91\u7b56\u7565\u79fb\u4ea4\u7ed9\u4e86 %s\u3002',\n      'Preview or confirm an explicit project permission handoff.' => '\u9884\u89c8\u6216\u786e\u8ba4\u663e\u5f0f\u9879\u76ee\u6743\u9650\u79fb\u4ea4\u3002',\n      'The handoff is unavailable or its preview is no longer current.' => '\u65e0\u6cd5\u6267\u884c\u79fb\u4ea4\uff0c\u6216\u9884\u89c8\u5df2\u7ecf\u5931\u6548\u3002',\n","current_offset":553,"parent":"","parent_offset":553}],"parent_bytes":1214074,"parent_sha256":"bba99b9e3a26de2a33e3316b950c6ac822f4d827c4ae4354dbb4d4b5ceabfdb5"},"tests/ci/test_core_focused_tiers.py":{"current_bytes":24530,"current_sha256":"a83df5d3996ae0eeb8cb2cb8c1916fd945c414eb82b2930c18c86d