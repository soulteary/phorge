# =============================================================================
# Phorge (phorge-fork) Docker Compose 环境变量
#
# 复制后按需修改：cp .env.example .env
# 每一项在 docker-compose.yml 里都有同样的内置默认值，所以不写 .env 也能跑；
# 但生产部署至少要改掉两个密码和 PHORGE_BASE_URI。
# =============================================================================

# --- 数据库 ---

# MySQL root 密码。只有 db-init（授权）和 mysql 自身的健康检查用到它，
# Phorge 应用不用 root 连库。
MYSQL_ROOT_PASSWORD=phorge_root

# Phorge 连库使用的普通账号。首次初始化数据卷时由 mysql 镜像创建，
# 随后由 db-init 授予 `phabricator_%` 整组库的权限。
MYSQL_USER=phorge

# 上述普通账号的密码，会同时下发给 mysql 和 phorge 两个服务。
MYSQL_PASSWORD=phorge

# mysql 镜像首次初始化时顺带创建的库。Phorge 实际使用的是
# phabricator_* 命名空间下的一组库，这里只是给普通账号一个落脚的默认库，
# 保持默认值即可。
MYSQL_DATABASE=phorge

# --- Phorge 应用 ---

# 宿主机映射端口，浏览器访问 http://127.0.0.1:<该端口>/
PHORGE_HTTP_PORT=8088

# 站点自身的绝对地址，Phorge 用它生成链接并校验请求的 Host 头。
# 默认保持注释：compose 会自动拼成 http://127.0.0.1:${PHORGE_HTTP_PORT}/，
# 这样只改上面的端口就不会漏改这里（端口不一致会 redirect 到错误地址）。
# 换成真实域名时再取消注释填写，注意域名必须含点号(.)，裸 "localhost"
# 会被 Phorge 拒绝。
# PHORGE_BASE_URI=https://code.example.com/

# 站点默认时区（phabricator.timezone），取 PHP 时区标识符，例如 Asia/Shanghai。
PHORGE_TIMEZONE=UTC

# --- 启动行为开关（严格取值 1 开启，其它任何值都视为关闭）---
# 注意: 上面几项只在首次生成 conf/local/local.json 时写入。该文件由
# phorge-conf 卷持久化，之后改 .env 不会覆盖它 —— 需要重新生成就先
# `docker compose exec phorge rm conf/local/local.json` 再重启容器，
# 或直接在 Web 界面 Config 里改。

# 是否在启动 Web 服务前等待数据库就绪。
# 关掉可以让容器更快起来，但首启动时 storage upgrade 大概率失败。
PHORGE_WAIT_DB=1

# 是否每次启动自动执行 bin/storage upgrade --force。
# 开箱可跑靠它；生产环境建议关掉，升级前先备份再手工迁移。
PHORGE_AUTO_UPGRADE=1

# 是否随容器启动 Phorge 守护进程 phd。
# phd 负责仓库拉取、任务队列、邮件投递等；容器内以 www-data 运行。
PHORGE_START_PHD=1

# =============================================================================
# --- Traefik Forward Auth（可选）---
#
# 以下变量仅在使用叠加编排文件时才生效：
#   docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d --build
# 不使用该叠加文件时（默认一键启动），这些变量完全用不到，可保持默认或删除。
# 每一项在 docker-compose.traefik.yml 里都有同名内置默认值，因此不写也能跑。
#
# 原理：Traefik 在前置做 Forward Auth，认证通过后向后端注入
# X-Auth-User / X-Auth-Email / X-Auth-Name 头，Phorge 的
# "Traefik Auth" Provider（PhabricatorTraefikAuthProvider）读取这些头完成
# 登录/注册。详见 DOCKER.md「通过 Traefik Forward Auth 运行」。
# =============================================================================

# 对外访问 Phorge 的域名，Traefik 依据它做路由匹配（Host 规则）。
# 必须含点号(.)，否则 Phorge 会拒绝该 Host。搭配叠加文件时，
# 建议把上面的 PHORGE_BASE_URI 也改成 https://${TRAEFIK_DOMAIN}/。
TRAEFIK_DOMAIN=phorge.local

# Traefik 入口监听的宿主端口（websecure/HTTPS 与 web/HTTP）。
# 叠加文件默认把 phorge 路由绑定在 websecure 上。
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Traefik ForwardAuth 中间件要回调的认证后端地址（占位）。
# 需要你自行提供真实的认证服务（如 authelia / oauth2-proxy），并保证它在
# 认证成功后返回 X-Auth-User/Email/Name 这几个响应头（会被复制到后端请求上）。
# 示例：http://authelia:9091/api/authz/forward-auth
TRAEFIK_FORWARD_AUTH_ADDRESS=http://auth-backend:9091/api/verify

# 认证通过后，从 ForwardAuth 响应里复制到后端请求的头名（逗号分隔）。
# 这些正是 Phorge Provider 依赖的头；请与你的认证后端实际返回的头对齐。
TRAEFIK_AUTH_RESPONSE_HEADERS=X-Auth-User,X-Auth-Email,X-Auth-Name

# 是否开启 Traefik 的 Dashboard（:8080，仅本机，用于排障）。
# 生产环境建议保持关闭。严格取值 true 开启。
TRAEFIK_DASHBOARD=false

# =============================================================================
# --- Gorge 语法高亮（可选）---
#
# 以下变量仅在使用叠加编排文件时才生效：
#   docker compose -f docker-compose.yml -f docker-compose.gorge.yml up -d --build
# --build 不能省：本地已有旧 phorge 镜像时会被直接复用，跑的是旧版 entrypoint，Gorge
# 的配置整段不下发也不报错，详见 docker-compose.gorge.yml 顶部说明。
# 不使用该叠加文件时（默认一键启动），这些变量完全用不到，可保持默认或删除。
# 每一项在 docker-compose.gorge.yml 里都有同名内置默认值，因此不写也能跑。
#
# 原理：叠加文件起一个 gorge-render 容器（基于 Chroma 的高亮服务），并把地址与
# token 下发给 phorge；entrypoint.sh 把它们写进 conf/local/local.json 的
# gorge.render.uri / gorge.render.token。与上面的 MYSQL_* 不同，这两项**不是**
# 守卫式写入，改完重启容器即生效，不必删 local.json。
# 起来之后还需要一步手工切换高亮引擎并清缓存，见 DOCKER.md
# 「用 Gorge 做语法高亮」。
# =============================================================================

# Phorge 访问 gorge-render 的基础地址，走 compose 内网服务名即可。
# 结尾不要带斜杠：客户端按 {uri}/api/highlight/render 拼接，双斜杠会被
# gorge-render 判成路由不匹配，返回 404 ERR_NOT_FOUND。
GORGE_RENDER_URI=http://gorge-render:8140

# 服务间共享密钥，PHP 客户端以请求头 X-Service-Token 发送。同一个值会同时下发给
# gorge-render（作为 GORGE_SERVICE_TOKEN）和 phorge，两端必须一致。
# 留空表示 gorge-render 不鉴权：默认它不对宿主暴露端口、只在 compose 内网可达，
# 所以留空可接受；若把它接到共享网络里，请设一个值。
GORGE_RENDER_TOKEN=

# gorge-render 的镜像标签（ghcr.io/soulteary/gorge-render）。语义化版本标签与
# latest 都有；生产建议钉到具体版本，避免 docker compose pull 悄悄换掉高亮实现。
GORGE_IMAGE_TAG=latest

# 单次高亮接受的源码大小上限（字节），超限返回 413，该文件回退到无高亮。
GORGE_RENDER_MAX_BYTES=1048576

# 单次高亮的服务端超时（秒）。
GORGE_RENDER_TIMEOUT_SEC=15

# =============================================================================
# --- Gorge 实时通知（可选）---
#
# 与上面的高亮共用同一个叠加编排文件：
#   docker compose -f docker-compose.yml -f docker-compose.gorge.yml up -d --build
# 两个服务互不依赖，也共用上面的 GORGE_IMAGE_TAG。
#
# 原理：叠加文件起一个 gorge-notification 容器，它与上游 Node.js 版 aphlict 线
# 兼容，一个进程监听两个端口（client :22280 收浏览器的 WebSocket，admin :22281
# 收 PHP 的投递与状态查询）。entrypoint.sh 把下面这些变量拼成两条记录写进
# conf/local/local.json 的 notification.servers。与高亮一样是非守卫式写入，
# 改完重启容器即生效。
#
# 为什么下面要分成 ADMIN_* 与 CLIENT_* 两组、还必须填不同的地址：这两条记录的
# 消费者不是同一个进程。admin 那条由 phorge 容器里的 PHP 使用，走 compose 内网
# 服务名即可；client 那条会被 Phorge 拼成 ws:// 地址**发给用户的浏览器**，浏览器
# 解析不了 compose 服务名，所以必须填一个从用户机器上够得着的地址。配置校验还要求
# 两条记录的 "host:port" 互不相同。填法与 Traefik 场景见 DOCKER.md
# 「用 Gorge 做实时通知」。
# =============================================================================

# PHP 访问通知服务 admin 端口用的地址，走 compose 内网服务名即可。
# 该端口刻意不映射到宿主：它为了与 aphlict 线兼容而不做任何鉴权，暴露出去等于
# 允许任何人代发通知。
GORGE_NOTIFICATION_ADMIN_HOST=gorge-notification
GORGE_NOTIFICATION_ADMIN_PORT=22281

# 浏览器连 WebSocket 用的地址与端口，写进 notification.servers 的 client 条目。
# 默认 127.0.0.1 只适合在 Docker 宿主本机上开浏览器；别人从局域网或公网访问时，
# 这里要填他们浏览器地址栏里用的那个主机名/IP（通常与 PHORGE_BASE_URI 同域名），
# 并且要同时放开下面的 GORGE_NOTIFICATION_CLIENT_BIND，否则端口只绑在回环上。
# PORT 同时也是容器发布到宿主的那个端口（容器一侧固定 22280），直连场景下两者
# 本来就必须相等，所以共用一个变量。走反向代理时它填反代的端口，见下面的说明。
GORGE_NOTIFICATION_CLIENT_HOST=127.0.0.1
GORGE_NOTIFICATION_CLIENT_PORT=22280

# 浏览器到 client 端口这一跳的协议与路径前缀。直连容器时保持默认；前面挂了
# Traefik / Nginx 做 TLS 终止时改成 https，并把 PATH 填成反代上那条 WebSocket
# 路由的路径（本仓库的 Traefik 叠加文件里是 /ws/），端口相应改成 443。
# 站点走 https 而这里留 http，浏览器会以「混合内容」为由拒绝建立 ws:// 连接。
# PATH 只对 client 条目合法，admin 条目带 path 会被配置校验拒绝，故没有对应项。
GORGE_NOTIFICATION_CLIENT_PROTOCOL=http
GORGE_NOTIFICATION_CLIENT_PATH=

# client 端口发布到宿主时绑哪张网卡（端口取上面的 CLIENT_PORT）。默认只绑回环，
# 与 GORGE_NOTIFICATION_CLIENT_HOST 的默认值配套。要让其他机器连上就改成
# 0.0.0.0，或指定某张网卡的地址，如 192.168.1.10。
# 走 Traefik 时应当改为完全不发布，做法见 DOCKER.md。
GORGE_NOTIFICATION_CLIENT_BIND=127.0.0.1

# =============================================================================
# --- Gorge 邮件（可选）---
#
# 与上面两项共用同一个叠加编排文件：
#   docker compose -f docker-compose.yml -f docker-compose.gorge.yml up -d --build
# 三个服务互不依赖，也共用上面的 GORGE_IMAGE_TAG。
#
# 原理：叠加文件起一个 gorge-mailer 容器，它把 SMTP / Sendmail / SES / SendGrid /
# Mailgun / Postmark 收在一个 HTTP API 后面。Phorge 侧它只是 cluster.mailers 里的
# 一个 type: "gorge" 的条目，entrypoint.sh 把下面这些变量拼成该条目写进
# conf/local/local.json。与高亮、通知一样是非守卫式写入，改完重启容器即生效。
#
# 与那两项有一处关键不同：cluster.mailers 是一个**共享列表**，你完全可以在里面手工
# 配自己的 mailer。entrypoint.sh 因此做的是**合并**——只覆盖 key 等于
# GORGE_MAILER_KEY 的那一条，其余条目原样保留。
#
# 另一处不同：这一组变量分成两半，且**两半都要填**。上半部分是「Phorge 怎么找到
# gorge-mailer」，都有可用默认值；下半部分是「gorge-mailer 用什么把信发出去」，
# **没有**默认值，不填的话服务起得来、/healthz 也是 200，但 /readyz 报 503、每一封
# 信都失败。详见 DOCKER.md「用 Gorge 发送邮件」。
# =============================================================================

# --- 上半：Phorge 侧（都有默认值）---

# Phorge 访问 gorge-mailer 的基础地址，走 compose 内网服务名即可。
# 它同时是整段发信配置的**总开关**：留空时 entrypoint.sh 整段跳过，
# cluster.mailers 一个字都不动。
# 结尾不要带斜杠：客户端按 {uri}/api/mailer/send 拼接，双斜杠会被判成路由不匹配，
# 返回 404 ERR_NOT_FOUND。
GORGE_MAILER_URI=http://gorge-mailer:8110

# 服务间共享密钥，PHP 客户端以请求头 X-Service-Token 发送。同一个值会同时下发给
# gorge-mailer（作为 GORGE_SERVICE_TOKEN）和 phorge，两端必须一致。
# 留空表示不鉴权。默认 gorge-mailer 不对宿主暴露端口、只在 compose 内网可达，所以
# 留空可接受；但它比另外两个服务更值得设一个值——能往这个口投请求就等于能以你的
# 域名对外发信。
GORGE_MAILER_TOKEN=

# 这个条目在 cluster.mailers 里的 key，也是 entrypoint.sh 认定「哪一条归我管」的
# 依据：只有 key 等于它的条目会在每次启动时被覆盖。想再手工配一条指向另一个实例的
# gorge mailer，换个 key 写进去即可，不会被覆盖掉。
GORGE_MAILER_KEY=gorge-mailer

# 单次发信请求的客户端超时（秒）。这一跳会占住一个 phd 队列 worker，而 gorge-mailer
# 内部已有自己的有界重试，所以不宜给大。
GORGE_MAILER_TIMEOUT=30

# 条目的 priority（数字越大越优先），留空表示不写这个键、用默认顺序。只有当
# cluster.mailers 里还有别的条目、需要指定谁先谁后时才用得上。必须大于 0。
GORGE_MAILER_PRIORITY=

# 是否允许 Phorge 自己指定 Message-ID（取值 1 开启）。默认关：gorge-mailer 后面挂着
# 7 种后端，走 SMTP / Sendmail / SES 时它自建 MIME、会保留这个头，走 SendGrid /
# Postmark 时 provider 通常会覆盖掉。谎报支持的表现是邮件会话在客户端里串不起来，
# 很难察觉，所以按你实际使用的后端来开。
GORGE_MAILER_SUPPORTS_MESSAGE_ID=0

# 单封邮件正文的长度上限（字节），纯文本与 HTML 各自计算，超出部分按 UTF-8 边界
# 截断、不报错。注意它**不是**整个请求体的上限：那一项固定 10MiB、没有开关，带附件
# 的邮件受它约束而不受这里约束。
GORGE_MAILER_BODY_LIMIT=524288

# 单个后端内部的重试次数，以及每次重试之间等待的秒数。语义是「同一个后端自己先重试
# 这么多次，仍不成功才回退到下一个后端」；被判定为永久失败（比如收件人地址非法）时
# 立即短路，既不重试也不换后端。
#
# 默认值小是刻意的，不是保守：外层重试的唯一权威是 Phorge 的 phd worker 队列，凡不是
# 永久失败的邮件它都会重新投递，gorge-mailer 这一层只用来吸收秒级抖动，重复造一个慢
# 重试循环没有意义。而且整个循环受请求上下文约束，上面的 GORGE_MAILER_TIMEOUT 默认只
# 等 30 秒——把这两个值调大的实际效果是客户端先超时放弃、服务端还在重试，白占一个
# worker 名额。
GORGE_MAILER_MAX_RETRIES=2
GORGE_MAILER_RETRY_WAIT=2

# --- 下半：gorge-mailer 侧的投递后端（没有默认值，必须填）---

# 方式一：一次配多个后端，直接给一段 JSON 列表（必须写成单行）。服务端按 priority
# 排序，前一个失败时依次回退。配了它，下面 MAILER_TYPE 那一组就整体不生效。
# 例：
#   GORGE_MAILER_CONFIG=[{"key":"primary","type":"smtp","priority":100,"options":{"host":"smtp.example.com","port":"587","protocol":"tls","user":"phorge@example.com","password":"..."}}]
GORGE_MAILER_CONFIG=

# 方式二（够用且好读）：选一种后端，再填它需要的那几项。
# 取值：smtp / sendmail / ses / sendgrid / mailgun / postmark / test
# 留空表示一个后端都没配 —— 服务会起来，但 /readyz 报 503，每一封信都失败。
# test 只把邮件丢掉，用来验证「Phorge 到服务」这一段链路，别用在生产上。
MAILER_TYPE=

# 后端在**服务端**的名字。与上面的 GORGE_MAILER_KEY 是两回事：那个是 Phorge 侧条目
# 的 key，这个只出现在服务端日志与 /api/mailer/mailers 的返回里。留空取服务端默认值。
MAILER_KEY=

# smtp 用（sendmail 不需要任何一项）。protocol 取 tls 或 ssl，留空表示明文。
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PROTOCOL=

# ses 用
MAILER_ACCESS_KEY=
MAILER_SECRET_KEY=
MAILER_REGION=
MAILER_ENDPOINT=

# sendgrid 用 MAILER_API_KEY；mailgun 三项都要
MAILER_API_KEY=
MAILER_DOMAIN=
MAILER_API_HOSTNAME=

# postmark 用
MAILER_ACCESS_TOKEN=
