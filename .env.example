# =============================================================================
# Phorge (phorge-fork) Docker Compose 环境变量
#
# 复制后按需修改：cp .env.example .env
# 每一项在 docker-compose.yml 里都有同样的内置默认值，所以不写 .env 也能跑；
# 但生产部署至少要改掉两个密码和 PHORGE_BASE_URI。
# =============================================================================

# --- 数据库 ---

# 默认编排与 legacy 编排共同使用的 MySQL 补丁版本锁。
MYSQL_IMAGE_TAG=8.0.46

# MySQL root 密码。只有 db-init（授权）和 mysql 自身的健康检查用到它，
# Phorge 应用不用 root 连库。
MYSQL_ROOT_PASSWORD=phorge_root

# Phorge 连库使用的普通账号。首次初始化数据卷时由 mysql 镜像创建，
# 随后由 db-init 授予 `phabricator_%` 整组库的权限。
MYSQL_USER=phorge

# 上述普通账号的密码，会同时下发给 mysql 和 phorge 两个服务。
MYSQL_PASSWORD=phorge

# mysql 镜像首次初始化时顺带创建的库。Phorge 实际使用的是
# phabricator_* 命名空间下的一组库，这里只是给普通账号一个落脚的默认库，
# 保持默认值即可。
MYSQL_DATABASE=phorge

# Phorge 与所有有状态 Gorge 服务共用的数据库命名空间。它同时
# 控制 db-init 授权、`auto` 安装检测、file-storage、webhook、
# taskqueue 与 db-api，禁止为这些服务分别填不同的前缀。
# 已有安装若修改过 storage.default-namespace，升级前必须在这里填相同值；
# entrypoint 发现它与 local.json 不一致时会直接拒绝启动。
PHORGE_DB_NAMESPACE=phabricator

# --- Phorge 应用 ---

# 本地构建的 Phorge 镜像名与标签。多个运行角色复用同一个镜像。
PHORGE_IMAGE_REPOSITORY=phorge
PHORGE_IMAGE_TAG=local

# 宿主机映射端口，浏览器访问 http://127.0.0.1:<该端口>/
PHORGE_HTTP_PORT=8088

# 站点自身的绝对地址，Phorge 用它生成链接并校验请求的 Host 头。
# 默认保持注释：compose 会自动拼成 http://127.0.0.1:${PHORGE_HTTP_PORT}/，
# 这样只改上面的端口就不会漏改这里（端口不一致会 redirect 到错误地址）。
# 换成真实域名时再取消注释填写，注意域名必须含点号(.)，裸 "localhost"
# 会被 Phorge 拒绝。
# PHORGE_BASE_URI=https://code.example.com/

# 站点默认时区（phabricator.timezone），取 PHP 时区标识符，例如 Asia/Shanghai。
PHORGE_TIMEZONE=UTC

# auto（默认）会让新安装选择 collaboration，已有数据库且没有历史选择时保持
# full；也可以显式写 collaboration 或 full。默认栈把选择原子写入只读的
# conf/local/deployment.json，后续启动不会重判；legacy 编排仍使用 local.json。
PHORGE_PRODUCT_PROFILE=auto

# configured Gorge 服务的失败策略：required（默认，失败即报错）、fallback
#（迁移期临时回退并记录日志）或 off（停用请求路由型 Gorge 服务）。
# webhook/taskqueue 的消费者所有权仍必须用各自 MODE 原子切换。
PHORGE_GORGE_POLICY=required

# 协作模式顶栏中的代码入口，也是 Gorge 校验事件链接同源性的基准 URI。
GITEA_BASE_URI=https://git.example.com/

# --- 启动行为开关 ---
# 镜像只有 migrate / web / daemon 三个角色（PHORGE_CONTAINER_ROLE，默认 web），
# 单容器 `all` 角色与 legacy 控制面都已移除。web 与 daemon 是配置的只读消费者：
# 缺少 conf/local/local.json 或 deployment.json 时它们直接退出，不会自己迁移。
# 因此不用 Compose 时也必须按 migrate → web → daemon 的顺序启动，三者共享同一个
# conf/local 卷，详见 DOCKER.md「不用 Compose 直接 docker run」。
#
# 注意: MYSQL_*、BASE_URI 与 TIMEZONE 只在首次生成 conf/local/local.json 时写入。
# 该文件由 phorge-conf 卷持久化，之后改 .env 不会覆盖它 —— 需要重新生成就先
# `docker compose exec phorge rm conf/local/local.json` 再重启容器，
# 或直接在 Web 界面 Config 里改。

# 是否在执行 storage upgrade 前等待数据库就绪（migrate 角色）。
# 关掉可以让容器更快起来，但首启动时 storage upgrade 大概率失败。
PHORGE_WAIT_DB=1

# 是否在 migrate 角色里自动执行 bin/storage upgrade --force。
# 开箱可跑靠它；生产环境建议关掉，升级前先备份再手工迁移。
# 只有 migrate 角色读它：web/daemon 永远不迁移 schema。
PHORGE_AUTO_UPGRADE=1

# =============================================================================
# --- Traefik Forward Auth（可选）---
#
# 以下变量仅在使用叠加编排文件时才生效：
#   docker compose -f docker-compose.yml -f docker-compose.traefik.yml up -d --build
# 不使用该叠加文件时（默认一键启动），这些变量完全用不到，可保持默认或删除。
# 每一项在 docker-compose.traefik.yml 里都有同名内置默认值，因此不写也能跑。
#
# 原理：Traefik 在前置做 Forward Auth，认证通过后向后端注入
# X-Auth-User / X-Auth-Email / X-Auth-Name 头，Phorge 的
# "Traefik Auth" Provider（PhabricatorTraefikAuthProvider）读取这些头完成
# 登录/注册。详见 DOCKER.md「通过 Traefik Forward Auth 运行」。
# =============================================================================

# 对外访问 Phorge 的域名，Traefik 依据它做路由匹配（Host 规则）。
# 必须含点号(.)，否则 Phorge 会拒绝该 Host。搭配叠加文件时，
# 建议把上面的 PHORGE_BASE_URI 也改成 https://${TRAEFIK_DOMAIN}/。
TRAEFIK_DOMAIN=phorge.local

# Traefik 入口监听的宿主端口（websecure/HTTPS 与 web/HTTP）。
# 叠加文件默认把 phorge 路由绑定在 websecure 上。
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Traefik ForwardAuth 中间件要回调的认证后端地址（占位）。
# 需要你自行提供真实的认证服务（如 authelia / oauth2-proxy），并保证它在
# 认证成功后返回 X-Auth-User/Email/Name 这几个响应头（会被复制到后端请求上）。
# 示例：http://authelia:9091/api/authz/forward-auth
TRAEFIK_FORWARD_AUTH_ADDRESS=http://auth-backend:9091/api/verify

# 认证通过后，从 ForwardAuth 响应里复制到后端请求的头名（逗号分隔）。
# 这些正是 Phorge Provider 依赖的头；请与你的认证后端实际返回的头对齐。
TRAEFIK_AUTH_RESPONSE_HEADERS=X-Auth-User,X-Auth-Email,X-Auth-Name

# 是否开启 Traefik 的 Dashboard（:8080，仅本机，用于排障）。
# 生产环境建议保持关闭。严格取值 true 开启。
TRAEFIK_DASHBOARD=false

# =============================================================================
# --- Gorge 默认核心服务 ---
#
# render、conduit、notification、file-storage、webhook、taskqueue、worker 与 db-api
# 已进入默认 docker-compose.yml。邮件、搜索和 Gitea bridge 分别用
# `--profile mailer`、`--profile search`、`--profile gitea` 启用。
#
# 默认控制面把所有服务端点、token、产品 profile，以及 webhook/taskqueue 的唯一消费者
# 一次生成到 conf/local/deployment.json，再用原子 rename 替换。Phorge 把它作为高于
# Web Config 数据库和 local.json 的只读配置源；改完环境变量后重跑 phorge-migrate 即生效。
# 本文件后续提到 entrypoint 写 local.json 的文字，仅描述 legacy + Gorge overlay 的兼容路径。
# 默认栈的服务协议与环境变量相同，但写入目标统一为 deployment.json。
# 起来之后可以独立启用高亮和 diff，见 DOCKER.md「用 Gorge 做语法高亮」。
# =============================================================================

# Phorge 访问 gorge-render 的基础地址，走 compose 内网服务名即可。
# 结尾不要带斜杠：客户端按 {uri}/api/highlight/render 拼接，双斜杠会被
# gorge-render 判成路由不匹配，返回 404 ERR_NOT_FOUND。
GORGE_RENDER_URI=http://gorge-render:8140

# 服务间共享密钥，PHP 客户端以请求头 X-Service-Token 发送。同一个值会同时下发给
# gorge-render（作为 GORGE_SERVICE_TOKEN）和 phorge，两端必须一致。
# 留空表示 gorge-render 不鉴权：默认它不对宿主暴露端口、只在 compose 内网可达，
# 所以留空可接受；若把它接到共享网络里，请设一个值。
GORGE_RENDER_TOKEN=

# Gorge 服务的公共镜像标签。默认锁定已发布版本，不跟随 latest 漂移。
GORGE_IMAGE_TAG=2026.09.09-r3

# gorge-render 在统一 package（ghcr.io/soulteary/gorge）里的标签后缀；实际镜像标签为
# render-${GORGE_RENDER_IMAGE_TAG}。留空时继承 GORGE_IMAGE_TAG，可单独钉住本服务。
GORGE_RENDER_IMAGE_TAG=

# 单次高亮接受的源码大小上限（字节），超限返回 413，该文件回退到无高亮。
GORGE_RENDER_MAX_BYTES=1048576

# 单次 diff 的 old 与 new 合计大小上限（字节）。diff 域与 render 共用进程，
# 但分别限制输入；超限时 Phorge 直接报错 —— 原生 diff 已经移除，没有可回退的
# 本地 difference engine 了。要处理更大的输入就调高这个值。
GORGE_DIFF_MAX_BYTES=1048576

# 单次高亮的服务端超时（秒）。
GORGE_RENDER_TIMEOUT_SEC=15

# 这里刻意没有 GORGE_RENDER_ENABLE_DIFF：原生 GNU/PHP diff 已经移除，编排把
# 服务端的 /api/diff/* 路由写死为开启，旧 .env 里残留的该变量会被忽略。

# =============================================================================
# --- Gitea 单向任务事件（可选）---
# =============================================================================
# 身份统一由 Stargate 维护。本桥只使用一个专用 Conduit bot，把标题、正文或提交
# 信息中的 T123 引用写回 Maniphest，不同步评审、不反向修改 Gitea。
# 当前正式 Gorge r3 早于 gorge-gitea 合入；发布新镜像后必须在启用 gitea profile
# 前填写对应标签，默认的 unreleased 会刻意让拉取失败，避免运行错误二进制。
GORGE_GITEA_PORT=8180
GORGE_GITEA_IMAGE_TAG=
GORGE_GITEA_SERVICE_TOKEN=
GORGE_GITEA_WEBHOOK_SECRET=
GORGE_GITEA_CONDUIT_TOKEN=
GORGE_GITEA_GATEWAY_TOKEN=
GORGE_GITEA_TIMEOUT_SEC=15

# =============================================================================
# --- Gorge Conduit 网关（可选）---
# =============================================================================
# 与上面的服务互不依赖，也共用上面的 GORGE_IMAGE_TAG。
#
# 原理：叠加文件起一个 gorge-conduit 容器，它是 Conduit API 的**反向代理网关**——
# 对经过 X-Service-Token 鉴权与 IP 令牌桶限流的请求，反代到上游 phorge 容器的
# /api/*。它把认证/限流/审计收敛到一个入口，主要服务方是同网络里的其它 Go 服务，
# phorge 侧则可选地通过 PhabricatorGorgeConduitClient 经网关发起 Conduit 调用。
# entrypoint.sh 把下面 GORGE_CONDUIT_URI / GORGE_CONDUIT_TOKEN 写进
# conf/local/local.json 的 gorge.conduit.uri / gorge.conduit.token。与 render 一样
# 是非守卫式写入，改完重启容器即生效，不必删 local.json。

# Phorge 访问 gorge-conduit 的基础地址，走 compose 内网服务名即可。
# 结尾不要带斜杠：客户端按 {uri}/api/{method} 拼接，双斜杠会被网关判成路由不匹配。
GORGE_CONDUIT_URI=http://gorge-conduit:8150

# 服务间共享密钥，PHP 客户端以请求头 X-Service-Token 发送。同一个值会同时下发给
# gorge-conduit（作为 GORGE_SERVICE_TOKEN）和 phorge（写进隐藏配置项
# gorge.conduit.token），两端必须一致。
# 留空表示 gorge-conduit 不鉴权：默认它不对宿主暴露端口、只在 compose 内网可达，
# 所以留空可接受；若把它接到共享网络里，请设一个值。
GORGE_CONDUIT_TOKEN=

# 网关反代的上游地址，指回本编排里的 phorge 容器。结尾不带斜杠：网关按
# {upstream}/api/{method} 拼接反代目标。
GORGE_CONDUIT_UPSTREAM_URL=http://phorge:80

# 反代单次请求的服务端超时（秒）。
GORGE_CONDUIT_PROXY_TIMEOUT_SEC=30

# 单次请求 body 的大小上限（字节），超限返回 413。默认 8MiB。
GORGE_CONDUIT_MAX_BODY_SIZE=8388608

# IP 令牌桶限流：每 IP 每秒补充的令牌数与突发上限，超限返回 429。
GORGE_CONDUIT_RATE_LIMIT_RPS=20
GORGE_CONDUIT_RATE_LIMIT_BURST=40

# =============================================================================
# --- Gorge 实时通知（可选）---
#
# 与上面的高亮共用同一个叠加编排文件：
#   docker compose up -d --build
# 两个服务互不依赖，也共用上面的 GORGE_IMAGE_TAG。
#
# 原理：叠加文件起一个 gorge-notification 容器，它与上游 Node.js 版 aphlict 线
# 兼容，一个进程监听两个端口（client :22280 收浏览器的 WebSocket，admin :22281
# 收 PHP 的投递与状态查询）。entrypoint.sh 把下面这些变量拼成两条记录写进
# conf/local/local.json 的 notification.servers。与高亮一样是非守卫式写入，
# 改完重启容器即生效。
#
# 为什么下面要分成 ADMIN_* 与 CLIENT_* 两组、还必须填不同的地址：这两条记录的
# 消费者不是同一个进程。admin 那条由 phorge 容器里的 PHP 使用，走 compose 内网
# 服务名即可；client 那条会被 Phorge 拼成 ws:// 地址**发给用户的浏览器**，浏览器
# 解析不了 compose 服务名，所以必须填一个从用户机器上够得着的地址。配置校验还要求
# 两条记录的 "host:port" 互不相同。填法与 Traefik 场景见 DOCKER.md
# 「用 Gorge 做实时通知」。
# =============================================================================

# PHP 访问通知服务 admin 端口用的地址，走 compose 内网服务名即可。
# 该端口刻意不映射到宿主：它为了与 aphlict 线兼容而不做任何鉴权，暴露出去等于
# 允许任何人代发通知。
GORGE_NOTIFICATION_ADMIN_HOST=gorge-notification
GORGE_NOTIFICATION_ADMIN_PORT=22281

# 浏览器连 WebSocket 用的地址与端口，写进 notification.servers 的 client 条目。
# 默认 127.0.0.1 只适合在 Docker 宿主本机上开浏览器；别人从局域网或公网访问时，
# 这里要填他们浏览器地址栏里用的那个主机名/IP（通常与 PHORGE_BASE_URI 同域名），
# 并且要同时放开下面的 GORGE_NOTIFICATION_CLIENT_BIND，否则端口只绑在回环上。
# PORT 同时也是容器发布到宿主的那个端口（容器一侧固定 22280），直连场景下两者
# 本来就必须相等，所以共用一个变量。走反向代理时它填反代的端口，见下面的说明。
GORGE_NOTIFICATION_CLIENT_HOST=127.0.0.1
GORGE_NOTIFICATION_CLIENT_PORT=22280

# 浏览器到 client 端口这一跳的协议与路径前缀。直连容器时保持默认；前面挂了
# Traefik / Nginx 做 TLS 终止时改成 https，并把 PATH 填成反代上那条 WebSocket
# 路由的路径（本仓库的 Traefik 叠加文件里是 /ws/），端口相应改成 443。
# 站点走 https 而这里留 http，浏览器会以「混合内容」为由拒绝建立 ws:// 连接。
# PATH 只对 client 条目合法，admin 条目带 path 会被配置校验拒绝，故没有对应项。
GORGE_NOTIFICATION_CLIENT_PROTOCOL=http
GORGE_NOTIFICATION_CLIENT_PATH=

# client 端口发布到宿主时绑哪张网卡（端口取上面的 CLIENT_PORT）。默认只绑回环，
# 与 GORGE_NOTIFICATION_CLIENT_HOST 的默认值配套。要让其他机器连上就改成
# 0.0.0.0，或指定某张网卡的地址，如 192.168.1.10。
# 走 Traefik 时应当改为完全不发布，做法见 DOCKER.md。
GORGE_NOTIFICATION_CLIENT_BIND=127.0.0.1

# =============================================================================
# --- Gorge 邮件（可选）---
#
# gorge-mailer 与写配置的 phorge-mailer-config 都在 mailer profile 上，必须显式启用：
#   docker compose --profile mailer up -d --build
# 不带 --profile mailer 时这两个容器根本不会起。它与上面两项互不依赖，也共用上面的
# GORGE_IMAGE_TAG。
#
# 原理：叠加文件起一个 gorge-mailer 容器，它把 SMTP / Sendmail / SES / SendGrid /
# Mailgun / Postmark 收在一个 HTTP API 后面。Phorge 侧它只是 cluster.mailers 里的
# 一个 type: "gorge" 的条目，entrypoint.sh 把下面这些变量拼成该条目写进
# conf/local/local.json。与高亮、通知一样是非守卫式写入，改完重启容器即生效。
#
# 与那两项有一处关键不同：cluster.mailers 是一个**共享列表**，你完全可以在里面手工
# 配自己的 mailer。entrypoint.sh 因此做的是**合并**——只覆盖 key 等于
# GORGE_MAILER_KEY 的那一条，其余条目原样保留。
#
# 另一处不同：这一组变量分成两半，且**两半都要填**。上半部分是「Phorge 怎么找到
# gorge-mailer」，都有可用默认值；下半部分是「gorge-mailer 用什么把信发出去」，
# **没有**默认值，不填的话服务起得来、/healthz 也是 200，但 /readyz 报 503、每一封
# 信都失败。详见 DOCKER.md「用 Gorge 发送邮件」。
# =============================================================================

# --- 上半：Phorge 侧（都有默认值）---

# Phorge 访问 gorge-mailer 的基础地址，走 compose 内网服务名即可。
# 它同时是整段发信配置的**总开关**：留空时 entrypoint.sh 整段跳过，
# cluster.mailers 一个字都不动。
# 结尾不要带斜杠：客户端按 {uri}/api/mailer/send 拼接，双斜杠会被判成路由不匹配，
# 返回 404 ERR_NOT_FOUND。
GORGE_MAILER_URI=http://gorge-mailer:8110

# 服务间共享密钥，PHP 客户端以请求头 X-Service-Token 发送。同一个值会同时下发给
# gorge-mailer（作为 GORGE_SERVICE_TOKEN）和 phorge，两端必须一致。
# 留空表示不鉴权。默认 gorge-mailer 不对宿主暴露端口、只在 compose 内网可达，所以
# 留空可接受；但它比另外两个服务更值得设一个值——能往这个口投请求就等于能以你的
# 域名对外发信。
GORGE_MAILER_TOKEN=

# 这个条目在 cluster.mailers 里的 key，也是 entrypoint.sh 认定「哪一条归我管」的
# 依据：只有 key 等于它的条目会在每次启动时被覆盖。想再手工配一条指向另一个实例的
# gorge mailer，换个 key 写进去即可，不会被覆盖掉。
GORGE_MAILER_KEY=gorge-mailer

# 单次发信请求的客户端超时（秒）。这一跳会占住一个 phd 队列 worker，而 gorge-mailer
# 内部已有自己的有界重试，所以不宜给大。
GORGE_MAILER_TIMEOUT=30

# 条目的 priority（数字越大越优先），留空表示不写这个键、用默认顺序。只有当
# cluster.mailers 里还有别的条目、需要指定谁先谁后时才用得上。必须大于 0。
GORGE_MAILER_PRIORITY=

# 是否允许 Phorge 自己指定 Message-ID（取值 1 开启）。默认关：gorge-mailer 后面挂着
# 7 种后端，走 SMTP / Sendmail / SES 时它自建 MIME、会保留这个头，走 SendGrid /
# Postmark 时 provider 通常会覆盖掉。谎报支持的表现是邮件会话在客户端里串不起来，
# 很难察觉，所以按你实际使用的后端来开。
GORGE_MAILER_SUPPORTS_MESSAGE_ID=0

# 单封邮件正文的长度上限（字节），纯文本与 HTML 各自计算，超出部分按 UTF-8 边界
# 截断、不报错。注意它**不是**整个请求体的上限：那一项固定 10MiB、没有开关，带附件
# 的邮件受它约束而不受这里约束。
GORGE_MAILER_BODY_LIMIT=524288

# 单个后端内部的重试次数，以及每次重试之间等待的秒数。语义是「同一个后端自己先重试
# 这么多次，仍不成功才回退到下一个后端」；被判定为永久失败（比如收件人地址非法）时
# 立即短路，既不重试也不换后端。
#
# 默认值小是刻意的，不是保守：外层重试的唯一权威是 Phorge 的 phd worker 队列，凡不是
# 永久失败的邮件它都会重新投递，gorge-mailer 这一层只用来吸收秒级抖动，重复造一个慢
# 重试循环没有意义。而且整个循环受请求上下文约束，上面的 GORGE_MAILER_TIMEOUT 默认只
# 等 30 秒——把这两个值调大的实际效果是客户端先超时放弃、服务端还在重试，白占一个
# worker 名额。
GORGE_MAILER_MAX_RETRIES=2
GORGE_MAILER_RETRY_WAIT=2

# --- 下半：gorge-mailer 侧的投递后端（没有默认值，必须填）---

# 方式一：一次配多个后端，直接给一段 JSON 列表（必须写成单行）。服务端按 priority
# 排序，前一个失败时依次回退。配了它，下面 MAILER_TYPE 那一组就整体不生效。
# 例：
#   GORGE_MAILER_CONFIG=[{"key":"primary","type":"smtp","priority":100,"options":{"host":"smtp.example.com","port":"587","protocol":"tls","user":"phorge@example.com","password":"..."}}]
GORGE_MAILER_CONFIG=

# 方式二（够用且好读）：选一种后端，再填它需要的那几项。
# 取值：smtp / sendmail / ses / sendgrid / mailgun / postmark / test
# 留空表示一个后端都没配 —— 服务会起来，但 /readyz 报 503，每一封信都失败。
# test 只把邮件丢掉，用来验证「Phorge 到服务」这一段链路，别用在生产上。
MAILER_TYPE=

# 后端在**服务端**的名字。与上面的 GORGE_MAILER_KEY 是两回事：那个是 Phorge 侧条目
# 的 key，这个只出现在服务端日志与 /api/mailer/mailers 的返回里。留空取服务端默认值。
MAILER_KEY=

# smtp 用（sendmail 不需要任何一项）。protocol 取 tls 或 ssl，留空表示明文。
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PROTOCOL=

# ses 用
MAILER_ACCESS_KEY=
MAILER_SECRET_KEY=
MAILER_REGION=
MAILER_ENDPOINT=

# sendgrid 用 MAILER_API_KEY；mailgun 三项都要
MAILER_API_KEY=
MAILER_DOMAIN=
MAILER_API_HOSTNAME=

# postmark 用
MAILER_ACCESS_TOKEN=

# =============================================================================
# --- Gorge 全文检索（可选）---
#
# gorge-search 与写配置的 phorge-search-config 都在 search profile 上，必须显式启用：
#   docker compose --profile search up -d --build
# 不带 --profile search 时这两个容器根本不会起。它与上面三项互不依赖，也共用上面的
# GORGE_IMAGE_TAG。
#
# 原理：叠加文件起一个 gorge-search 容器，它把 Elasticsearch 与 Meilisearch 收在一个
# HTTP API 后面。Phorge 侧它是 cluster.search 里的一个 type: "gorge" 条目，走的是原生
# 的 PhabricatorFulltextStorageEngine 扩展点，entrypoint.sh 把下面这些变量拼成该条目
# 写进 conf/local/local.json。与前三项一样是非守卫式写入，改完重启容器即生效。
#
# 与发信一样，这一组也分成两半、**两半都要填**：上半是「Phorge 怎么找到 gorge-search」，
# 都有可用默认值；下半是「gorge-search 用什么引擎去搜」，**没有**默认值，不填的话服务
# 起得来、/healthz 也是 200，但 /readyz 报 503、每一次检索都失败。
#
# 还有一件前三项都没有的事：**首次启用必须手工建一次索引**
#   bin/search init && bin/search index --all --force
# 而且 `bin/search ngrams` 在这个引擎下**不适用**（它是 MySQL/Ferret 专属的路径）。
# 详见 DOCKER.md「用 Gorge 做全文搜索」。
# =============================================================================

# --- 上半：Phorge 侧（都有默认值）---

# Phorge 访问 gorge-search 用的地址，走 compose 内网服务名即可。
# 这里是 host / port / protocol 三件套而不是一个 URI，因为 cluster.search 条目的
# hosts 就是这么描述的（与 notification.servers 同理）。
#
# HOST 同时是整段检索配置的**总开关**：留空时 entrypoint.sh 整段跳过，
# cluster.search 一个字都不动。
GORGE_SEARCH_HOST=gorge-search
GORGE_SEARCH_PORT=8120
GORGE_SEARCH_PROTOCOL=http

# 服务间共享密钥，PHP 客户端以请求头 X-Service-Token 发送。同一个值会同时下发给
# gorge-search（作为 GORGE_SERVICE_TOKEN）和 phorge（写进隐藏配置项
# gorge.search.token），两端必须一致。留空表示不鉴权：默认 gorge-search 不对宿主暴露
# 端口、只在 compose 内网可达，所以留空可接受；但能往这个口投请求就等于能读写整个
# 索引，接到共享网络里请设一个值。
GORGE_SEARCH_TOKEN=

# 是否在 cluster.search 里保留一条 mysql 条目（取值 1 开启）。
#
# 默认关：写进去的就只有 gorge 一条，MySQL（Ferret）全文检索不再被读到。
# 开启后列表是 [gorge, mysql]，两条都可写意味着**双写双索引**；读按列表顺序优先走
# gorge，gorge 出错时回落到 MySQL。
#
# 这是为回滚准备的开关，两个方向都幂等：从 1 翻回 0 会把 mysql 条目摘掉，从 0 翻回 1
# 会把它补上（不依赖它此刻是否还在列表里）。Ferret 索引由一个扩展始终维护、不受
# cluster.search 影响，所以开着它几乎没有额外开销，代价是「这次检索由谁回答」多了一层
# 不确定性。
GORGE_SEARCH_KEEP_MYSQL=0

# --- 下半：gorge-search 侧的搜索后端（没有默认值，必须填）---
#
# 后端实例本身**不在**这个编排里：Elasticsearch 的内存、磁盘、数据卷与版本升级都该按
# 你自己的规模来定。把下面的地址指向你已有的实例即可。

# 方式一：一次配多个后端，直接给一段 JSON 列表（必须写成单行）。配了它，下面
# GORGE_SEARCH_ENGINE 那一组就整体不生效。
# 例：
#   GORGE_SEARCH_BACKENDS=[{"type":"elasticsearch","hosts":["es-1:9200","es-2:9200"],"index":"phabricator","version":7,"protocol":"http","timeout":15,"roles":["read","write"]}]
GORGE_SEARCH_BACKENDS=

# 方式二（够用且好读）：选一种引擎，再填它需要的那几项。
# 取值：elasticsearch（留空同义）/ meilisearch
GORGE_SEARCH_ENGINE=

# elasticsearch 用。ES_HOST 可以是逗号分隔的多台（如 es-1:9200,es-2:9200），
# 服务端自己维护主机健康表并在其间回退。留空表示一个后端都没配。
ES_HOST=
ES_PROTOCOL=
# 索引名，留空取服务端默认值 phabricator —— 与 Phorge 自带的 Elasticsearch 引擎同名，
# 所以从那个引擎切过来可以复用同一个索引；但 mapping 不同，仍然必须重建。
ES_INDEX=
# 主版本号，留空取服务端默认值 5。**这一项必须与集群的真实主版本一致**，它不是给日志看的：
# mapping 里文档类型放在哪儿由它决定。ES 5 及更早每个文档类型一份 mapping（Phorge 自带引擎
# 的布局）；ES 6 一个索引只允许一个类型；ES 7 起类型被彻底移除，类型改为文档上的 docType
# 字段。填小了（比如对着 ES 7 集群写 5）不会退化成"少个优化"，而是 mapping 直接被拒、
# 索引建不出来，之后每次检索都失败。
ES_VERSION=
ES_TIMEOUT=

# meilisearch 用
MEILI_HOST=
MEILI_PROTOCOL=
MEILI_INDEX=
MEILI_MASTER_KEY=
MEILI_TIMEOUT=

# =============================================================================
# --- Gorge 文件存储（可选）---
#
# 与上面四项共用同一个叠加编排文件：
#   docker compose up -d --build
# 五个 Gorge 服务之间互不依赖，也共用上面的 GORGE_IMAGE_TAG（本服务额外依赖 mysql 与
# db-init，见下面第二点）。
#
# 原理：叠加文件起一个 gorge-file-storage 容器，它把 MySQL blob、本地磁盘、S3/MinIO 收在
# 一个 HTTP API 后面。Phorge 侧它是一个自动被发现的 PhabricatorFileStorageEngine
# （identifier: gorge），entrypoint.sh 把下面 GORGE_FILE_URI / GORGE_FILE_TOKEN 写进
# conf/local/local.json 的 gorge.file.uri / gorge.file.token。与前四项一样是非守卫式写入，
# 改完重启容器即生效。
#
# 与前四项都不同的三件事：
#
#   一、**启用是两步，第一步单独做等于白做且不报错。** 写了 gorge.file.uri 只是让这个引擎
#   变成「可写」；Phorge 原生的 blob 引擎 priority 是 1、比它的 2 更小，仍然先拿到每一个
#   文件。默认配置下的实际效果是「1MB 以内进 MySQL，1MB~8MB 进 gorge」，也就是新文件按大小
#   散落在两套引擎里。第二步是关掉原生引擎：
#       bin/config set storage.mysql-engine.max-size 0
#       bin/config set storage.local-disk.path null
#       bin/config set storage.s3.bucket null
#   切换是安全的增量迁移：引擎标识是**按文件**存在库里的，已存文件仍由当初写它的引擎读取，
#   不需要搬数据，回滚也只是把上面三项设回去。详见 DOCKER.md「用 Gorge 做文件存储」。
#
#   二、**它有状态。** 本地磁盘后端写一个新增的 phorge-files 卷，blob 后端写 phorge 自己的
#   file_storageblob 表。它与 gorge-webhook 也是仅有的两个 depends_on mysql 与 db-init 的服务。
#
#   三、**它开箱就有一个可写后端**（本地磁盘，落在 phorge-files 卷里），所以不像发信与检索
#   那样必须你先配后端。相应地，它的容器健康检查探的是 /readyz 而不是 /healthz —— 真把下面
#   三个后端全部关掉的话，phorge 会一直等在 depends_on 上，理由见叠加文件里的注释。
# =============================================================================

# --- 上半：Phorge 侧（都有默认值）---

# Phorge 访问 gorge-file-storage 的基础地址，走 compose 内网服务名即可。
# 它同时是整段文件存储配置的**总开关**：留空时 entrypoint.sh 整段跳过，
# gorge.file.uri 一个字都不动，引擎也就不会被认为可写。
# 结尾不要带斜杠：客户端按 {uri}/api/file/blob 拼接，双斜杠会被判成路由不匹配，
# 返回 404 ERR_NOT_FOUND。
GORGE_FILE_URI=http://gorge-file-storage:8100

# 服务间共享密钥，PHP 客户端以请求头 X-Service-Token 发送。同一个值会同时下发给
# gorge-file-storage（作为 GORGE_SERVICE_TOKEN）和 phorge（写进隐藏配置项
# gorge.file.token），两端必须一致。
# 留空表示不鉴权。默认它不对宿主暴露端口、只在 compose 内网可达，所以留空可接受；但它和
# gorge-mailer 一样值得设一个值——能往这个口投请求就等于能读写、删除站点上的任意文件，
# 而读一个文件只需要一个 handle。
GORGE_FILE_TOKEN=

# --- 下半：gorge-file-storage 侧的存储后端（都有默认值，本地磁盘开箱可用）---
#
# 这一组的名字都带 GORGE_FILE_ 前缀，与 gorge 仓库自己的 deploy/compose 一致。服务端
# 也认无前缀的旧名（STORAGE_NAMESPACE / LOCAL_DISK_PATH / S3_BUCKET …），但那是留给
# 独立服务时期旧部署的兜底，不要在这里用：这个 .env 是整套编排共用的，无前缀的名字会和
# 上面数据库一节的 MYSQL_* 挤在同一个命名空间里。
#
# 唯一的例外是 blob 后端的连库参数，**这一组里刻意没有它们**：叠加文件把容器里的
# GORGE_FILE_MYSQL_USER / _PASS 直接接到本文件最上面「数据库」一节的 MYSQL_USER /
# MYSQL_PASSWORD 上，host 与 port 则写成字面量 mysql:3306。不另开一份是刻意的——连库
# 参数填错的表现不是报错，而是 blob 写入失败后按 priority **静默下沉**到本地磁盘后端，
# 事后只能翻 file 表里的引擎标识才看得出来，所以宁可让它与 phorge 自己用的那一份共享
# 同一个来源。

# 库名前缀，必须与 Phorge 的 storage.default-namespace 一致。blob 后端写的是
# {namespace}_file.file_storageblob，也就是 Phorge 原生 MySQL 引擎用的**同一张表**。
# Phorge 该配置项的默认值是 phabricator，本编排没有改它，所以这里也是 phabricator。
# 留空不等于「用默认值」：服务端的默认值是 phorge，会连到一个不存在的库。填错或留空的
# 表现都不是报错，而是静默下沉到本地磁盘。
GORGE_FILE_NAMESPACE=phabricator

# 单个 blob 的大小上限（字节），超过就交给下一个后端。默认 1MiB，与 Phorge 的
# storage.mysql-engine.max-size 默认值一致。设成 0 表示不启用 blob 后端。
GORGE_FILE_MYSQL_BLOB_MAX_SIZE=1048576

# 本地磁盘后端在容器内的数据目录，对应 phorge-files 卷。这是**默认可写的那个后端**。
# 留空表示不启用；这么做之前请确认 blob 或 S3 至少有一个可写，否则 /readyz 不通，而
# phorge 的 depends_on 探的正是它。
GORGE_FILE_LOCAL_DISK_PATH=/var/gorge/files

# S3 / MinIO 后端。五项**全部**填齐才启用，缺一项就整组不注册。
# 注意 S3 后端的 key 前缀格式是**存量文件的读取依据**，改了以后旧文件读不出来且不报错，
# 所以别在已经有数据之后调整它。
GORGE_FILE_S3_BUCKET=
GORGE_FILE_S3_REGION=
GORGE_FILE_S3_ENDPOINT=
GORGE_FILE_S3_ACCESS_KEY=
GORGE_FILE_S3_SECRET_KEY=

# =============================================================================
# --- Gorge Webhook 投递（可选）---
#
# 与上面五项共用同一个叠加编排文件：
#   docker compose up -d --build
# 六个 Gorge 服务之间互不依赖，也共用上面的 GORGE_IMAGE_TAG（本服务与 gorge-file-storage
# 一样额外依赖 mysql 与 db-init）。
#
# 原理：叠加文件起一个 gorge-webhook 容器，它接管 Herald 的 webhook 投递 —— 也就是 phd
# 里 HeraldWebhookWorker 干的那件事。**它不被 phorge 调用**：PHP 侧照旧把 webhook request
# 写进 {namespace}_herald.herald_webhookrequest，服务自己轮询 status='queued' 的行，抢占、
# 用 hook 的 HMAC key 签名 POST、再把结果回写同一行。两边之间没有任何 HTTP 调用。
#
# 与前五项都不同的三件事：
#
#   一、**服务地址与所有权已经分离。** 默认控制面把 gorge.webhook.owner 明确设为 gorge，
#   并与 URI 在同一次原子替换中生效（全局 phabricator.silent 仍会阻止实际委派）。
#   PHP 侧真正会去访问这个地址的只有 Config 页面上的 PhabricatorGorgeWebhookSetupCheck。
#
#   二、**危险的方向和文件存储正好相反。** 文件存储的坑是「配了不生效」；这里的坑是
#   「服务在跑但配置没写进去」会让 phd 与 Go 竞争同一批行，部分请求可能重复投递。所以
#   GORGE_WEBHOOK_URI 和 docker-compose.gorge.yml 里的 gorge-webhook 段是一对，要停就
#   两边一起停。统一控制面不会暴露 owner 与 URI 只更新一半的状态。
#
#   三、**没有第二步手工切换，也没有回滚。** 写进去就立刻生效，不用切引擎也不用清缓存。
#   但反向那一步已经不存在了：原生 PHP 投递消费者已经移除，把 owner 切回 phorge 或清空
#   URI 都不会让 phd 接着发——那只是让 webhook 没有任何消费者，请求会被记录下来然后以
#   native-retired 失败。gorge-webhook 是唯一的投递方，停了它只能再把它起回来。
#
# 一个必须知道的例外：开了全局静默（phabricator.silent）时这一项等于没配。静默是 phorge
# 自己的配置，Go 服务读不到它（它只认每条 request 上记录的 per-request silent 标记），
# 让路给 Go 会把静默模式本该压住的 webhook 照样发出去。所以守卫要求「已配置**且**未静默」，
# 静默场景仍由 phd 按原样把每个请求失败掉。
# =============================================================================

# --- 上半：Phorge 侧（都有默认值）---

# 默认栈中这是诊断端点，所有权由生成的 gorge.webhook.owner 独立表达；未显式配置 owner
# 时仍保留“非空 URI 选择 Gorge”的兼容语义 —— 反过来说，清空它会让 owner 落到 phorge，
# 而 phorge 侧已经没有投递实现了。
# 结尾不要带斜杠：setup check 按 {uri}/healthz、{uri}/readyz 拼接。
GORGE_WEBHOOK_URI=http://gorge-webhook:8160

# 只能是 enable。原生 PHP 投递已经移除，disable 会让 phorge-migrate 直接报错退出：
# 那样写出来的 deployment.json 把投递交给一个不存在的消费者，webhook 会被记录下来
# 然后以 native-retired 失败，而不是发出去。
GORGE_WEBHOOK_MODE=enable

# 服务间共享密钥，PHP 客户端以请求头 X-Service-Token 发送。同一个值会同时下发给
# gorge-webhook（作为 GORGE_SERVICE_TOKEN）和 phorge（写进隐藏配置项 gorge.webhook.token）。
# 它保护的**只是** /api/webhook/stats 与 /api/webhook/hooks 这两个诊断接口，投递本身不经过
# 它 —— 投递走数据库，签名用的是每个 hook 自己的 HMAC key。所以留空的风险比另外几个服务
# 小：泄露的上限是队列计数。
GORGE_WEBHOOK_TOKEN=

# --- 下半：gorge-webhook 侧（连库参数复用上面「数据库」一节，这里只有两组）---
#
# 这一组的名字都带 GORGE_WEBHOOK_ 前缀，与 gorge 仓库自己的 deploy/compose 一致。服务端
# 也认无前缀的旧名（MYSQL_HOST / STORAGE_NAMESPACE / SERVICE_TOKEN …），但那是留给独立
# 服务时期旧部署的兜底，不要在这里用：这个 .env 是整套编排共用的，无前缀的名字会和上面
# 数据库一节的 MYSQL_* 挤在同一个命名空间里。
#
# 连库参数（host / port / user / pass）刻意不在这里出现：叠加文件把它们直接接到本文件
# 最上面「数据库」一节的 MYSQL_USER / MYSQL_PASSWORD 上，host 与 port 写成字面量
# mysql:3306。这不是「服务自己的库」，就是 phorge 的库，另开一份只会让两份漂移。

# 库名前缀，必须与 Phorge 的 storage.default-namespace 一致 —— 服务连的是
# {namespace}_herald 这个库。Phorge 该配置项的默认值是 phabricator，本编排没有改它。
# 留空不等于「用默认值」：服务端的默认值是 phorge，会连到一个不存在的库，表现是
# /readyz 永远不通、队列一直堆着不投递（Herald 界面上看就是一排蓝色的 Queued）。
GORGE_WEBHOOK_NAMESPACE=phabricator

# 投递行为，全部留空即用服务端默认值。默认值是照着 PHP 侧原本的行为定的，调之前先想清楚
# 代价不对称：调小放大失败重投的压力，调大让「事务发生到 webhook 送达」的延迟变长。
#   POLL_INTERVAL_MS    轮询间隔（毫秒，默认 1000）
#   DELIVERY_TIMEOUT    单次投递的 HTTP 超时（秒，默认 15，与 HeraldWebhookWorker 一致）
#   MAX_CONCURRENT      并发投递上限（默认 8）
#   ERROR_THRESHOLD     单个 hook 连续失败到多少次进入熔断（默认 10）
#   ERROR_BACKOFF_SEC   熔断窗口（秒，默认 300）
#   RETRY_BACKOFF_SEC   单个失败请求隔多久重投（秒，默认 60）
#   CLAIM_LEASE_SEC     抢占租约，即多久后认定抢到该行的进程已死（秒，默认 30）
# ERROR_* 两项对应 PHP 侧 HeraldWebhook::isInErrorBackoff() 的同名行为。
#
# RETRY_BACKOFF_SEC 与 ERROR_BACKOFF_SEC 名字像、量不同，别混：前者管**一个 request**
# 的重试节奏（60 秒，与 PHP 侧 worker 抛异常后的默认重试等待一致），后者管**整个 hook**
# 停投多久（300 秒）。
#
# CLAIM_LEASE_SEC 低于 DELIVERY_TIMEOUT 时服务端会自动抬到与它相等：租约比一次投递还短，
# 等于把 claim 本来要防的重复投递又放了回来。调大它只影响「崩溃实例留下的行要静置多久」。
#
# 这两项**会互相压制**，调之前要知道：一个失败过的 request 要重投，必须同时越过租约和
# 重投退避两道条件，所以实际重投间隔是 max(CLAIM_LEASE_SEC, RETRY_BACKOFF_SEC)。默认值
# 下租约 30 < 退避 60，所以 60 生效；但把 RETRY_BACKOFF_SEC 调到 30 以下不会有任何效果，
# 会被租约静默抬回 30。真要缩短重投间隔，两项得一起调小。
GORGE_WEBHOOK_POLL_INTERVAL_MS=
GORGE_WEBHOOK_DELIVERY_TIMEOUT=
GORGE_WEBHOOK_MAX_CONCURRENT=
GORGE_WEBHOOK_ERROR_THRESHOLD=
GORGE_WEBHOOK_ERROR_BACKOFF_SEC=
GORGE_WEBHOOK_RETRY_BACKOFF_SEC=
GORGE_WEBHOOK_CLAIM_LEASE_SEC=

# =============================================================================
# --- Gorge 任务队列控制面（默认启用）---
#
# 默认栈把 endpoint、owner 和 phd.taskmasters 写在同一份 deployment.json 中。
# MODE 只能是 enable：原生 taskmaster 守护进程已经移除（phd 不再启动它），
# disable 会让 phorge-migrate 直接报错退出，否则任务会写进 SQL 队列而无人领取。
# =============================================================================

GORGE_TASKQUEUE_URI=http://gorge-taskqueue:8090
GORGE_TASKQUEUE_TOKEN=
GORGE_TASKQUEUE_MODE=enable
GORGE_TASKQUEUE_NAMESPACE=phabricator

# =============================================================================
# --- Gorge 数据库诊断 API（可选）---
#
# 与其它 Gorge 服务共用叠加编排文件：
#   docker compose up -d --build
#
# gorge-db-api 只读访问 Phorge 的 MySQL，提供数据库健康、schema 差异、环境检查与
# storage upgrade 进度接口。PHP 侧的 PhabricatorGorgeDBClient 已支持这些接口；
# entrypoint.sh 会把下面的 URL / token 写进 gorge.db.uri / gorge.db.token。
#
# 单节点默认部署直接复用文件开头的 MYSQL_USER / MYSQL_PASSWORD，服务地址固定为
# compose 内网的 mysql:3306，无需再维护一份数据库凭据。
# =============================================================================

# enable 使用 db-api；disable 会由 entrypoint 清除已持久化的 URI/token，让 PHP
# 回落到原生数据库诊断路径。
GORGE_DB_MODE=enable

# Phorge 访问 db-api 的基础地址。
GORGE_DB_URL=http://gorge-db-api:8080

# 服务间共享密钥，两端必须一致。留空表示不鉴权；服务默认只在 compose 内网可达。
GORGE_DB_TOKEN=

# db-api 在统一 package（ghcr.io/soulteary/gorge）里的标签后缀；实际镜像标签为
# db-api-${GORGE_DB_IMAGE_TAG}。留空时继承公共的 GORGE_IMAGE_TAG。
GORGE_DB_IMAGE_TAG=

# 必须与 Phorge 的 storage.default-namespace 一致。默认 Phorge 安装使用 phabricator。
GORGE_DB_NAMESPACE=phabricator

# 可选的 Phorge local.json 容器内路径。留空使用单节点模式；用于多节点拓扑时，还需
# 通过 compose override 把 local.json 以只读方式挂载到 gorge-db-api 容器的同一路径。
GORGE_DB_CONFIG_FILE=
